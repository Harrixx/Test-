[
  {
    "name": "theme_info",
    "theme_name": "Trendloop",
    "theme_version": "1.0.0",
    "theme_author": "Trendloop",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background", "default": "#FAFAF7" },
      { "type": "color", "id": "color_surface", "label": "Cards and panels", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#141414" },
      { "type": "color", "id": "color_accent", "label": "Accent (buttons, badges)", "default": "#FF4D2E" },
      { "type": "color", "id": "color_accent_contrast", "label": "Text on accent", "default": "#FFFFFF" },
      { "type": "color", "id": "color_sale", "label": "Sale price", "default": "#D9262F" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Headings", "default": "assistant_n7" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body", "default": "assistant_n4" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
      { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 14 }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Show quick add button", "default": true },
      { "type": "text", "id": "card_trending_tag", "label": "Tag that shows the \"Trending\" badge", "default": "trending" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In your store's currency. Shows a progress bar in the cart. Set to 0 to hide. This only displays a message; set the actual free-shipping rate in Settings > Shipping.",
        "default": 50
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "placeholder": "https://instagram.com/yourstore" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok", "placeholder": "https://tiktok.com/@yourstore" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "placeholder": "https://facebook.com/yourstore" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube", "placeholder": "https://youtube.com/@yourstore" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon image", "info": "Square, at least 32 x 32px" }
    ]
  }
]
