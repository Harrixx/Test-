{%- comment -%}
  Line items list shared by the cart page and cart drawer.
  Accepts:
  - context: {String} 'drawer' or 'page'
{%- endcomment -%}
<ul class="cart-items">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="cart-item__media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__variant">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-item__row">
          <div class="qty qty--small">
            <button type="button" class="qty__btn" data-cart-qty="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', name: 'minus', class: 'icon--xs' %}</button>
            <input
              class="qty__input"
              type="number"
              {% if context == 'page' %}name="updates[]"{% endif %}
              value="{{ item.quantity }}"
              min="0"
              data-cart-input
              data-line="{{ forloop.index }}"
              aria-label="{{ 'products.product.quantity.label' | t }}"
            >
            <button type="button" class="qty__btn" data-cart-qty="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', name: 'plus', class: 'icon--xs' %}</button>
          </div>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove link" data-cart-qty="0" data-line="{{ forloop.index }}">{{ 'sections.cart.remove' | t }}</a>
        </div>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>
