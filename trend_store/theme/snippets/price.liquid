{%- comment -%}
  Renders a price with optional compare-at price and savings badge.
  Accepts:
  - product: {Object} product (required)
  - use_variant: {Boolean} use the selected/first-available variant instead of the product's lowest price
  - show_badge: {Boolean} show "Save X%" pill
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
    assign price = target.price
    assign compare_at = target.compare_at_price
    assign price_varies = false
  else
    assign target = product
    assign price = product.price
    assign compare_at = product.compare_at_price
    assign price_varies = product.price_varies
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
    assign savings_percent = compare_at | minus: price | times: 100 | divided_by: compare_at
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}" data-price>
  <span class="price__current">
    {%- if price_varies -%}
      {%- assign price_money = price | money -%}
      {{ 'products.product.price.from_price_html' | t: price: price_money }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      {{ compare_at | money }}
    </s>
    {%- if show_badge -%}
      <span class="price__badge">{{ 'products.product.price.save_percent' | t: percent: savings_percent }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
