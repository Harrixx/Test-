{%- comment -%}
  Accepts:
  - paginate: {Object}
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__link">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a>
    {%- endif -%}
  </nav>
{%- endif -%}
