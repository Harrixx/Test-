{%- comment -%}
  Progress toward the free-shipping threshold set in Theme settings > Cart.
  Display only: the actual rate is configured in Shopify admin.
  The threshold is in the store's default currency.
{%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  -%}
  <div class="ship-bar">
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}">
      <span class="ship-bar__fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
