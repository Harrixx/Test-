{%- assign collection = section.settings.collection -%}
<section class="section page-width">
  <div class="section__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if collection != blank and section.settings.show_view_all -%}
      <a href="{{ collection.url }}" class="link-arrow">{{ 'sections.featured_collection.view_all' | t }}{% render 'icon', name: 'arrow', class: 'icon--sm' %}</a>
    {%- endif -%}
  </div>

  <ul class="grid grid--{{ section.settings.columns_desktop }}-col">
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', card_product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <li>{% render 'product-card', card_product: blank, placeholder_index: i %}</li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hot right now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
