<section class="section page-width">
  <ul class="trust">
    {%- for block in section.blocks -%}
      <li class="trust__item" {{ block.shopify_attributes }}>
        <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div>
          <h3 class="trust__heading">{{ block.settings.heading | escape }}</h3>
          <p class="trust__text">{{ block.settings.text | escape }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Trust badges",
  "class": "section-trust",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat", "label": "Chat" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fast shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Orders leave our warehouse within 24 hours." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck" } },
        { "type": "badge", "settings": { "icon": "return", "heading": "30-day returns", "text": "Not obsessed? Send it back, no questions asked." } },
        { "type": "badge", "settings": { "icon": "lock", "heading": "Secure checkout", "text": "Encrypted payments powered by Shopify." } }
      ]
    }
  ]
}
{% endschema %}
