<section class="section page-width">
  <div class="newsletter-banner">
    <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {% render 'newsletter-form', form_id: section.id %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first to the next viral drop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join the list for restock alerts and subscriber-only deals.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
