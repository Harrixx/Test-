{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="section page-width product" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="product__grid">
    {%- comment -%} Media gallery {%- endcomment -%}
    <div class="product__media" data-gallery>
      <div class="gallery__main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if featured_media and media.id == featured_media.id
                assign is_active = true
              elsif featured_media == blank and forloop.first
                assign is_active = true
              endif
              if forloop.first
                assign media_loading = 'eager'
              else
                assign media_loading = 'lazy'
              endif
            -%}
            <div class="gallery__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: media_loading,
                      widths: '550,750,1000,1400',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      class: 'gallery__img'
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, class: 'gallery__video' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: class: 'gallery__video' }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: class: 'gallery__model' }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'gallery__img placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" aria-label="{{ 'products.product.media_gallery' | t }}">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="gallery__thumb{% if featured_media and media.id == featured_media.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.product.view_media' | t: number: forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'text' -%}
            <p class="product__text product__text--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" data-price-wrapper {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: true, show_badge: true %}
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="product__tax">
                  {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-picker__option">
                    <legend class="variant-picker__label">
                      {{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="variant-picker__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                        <input
                          type="radio"
                          class="visually-hidden"
                          id="{{ input_id }}"
                          name="{{ section.id }}-option-{{ option.position }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label for="{{ input_id }}" class="pill">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="product-form__row">
                  <div class="qty" data-qty>
                    <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
                    <input class="qty__input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity.label' | t }}">
                    <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
                  </div>
                  <button
                    type="submit"
                    name="add"
                    class="button button--large product-form__submit"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
                <p class="form-message form-message--error" data-form-error hidden role="alert"></p>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                {{ block.settings.heading | escape }}
                {% render 'icon', name: 'chevron', class: 'icon--sm' %}
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>

          {%- when 'trust' -%}
            <ul class="product__perks" {{ block.shopify_attributes }}>
              {%- if block.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'truck', class: 'icon--sm' %}{{ block.settings.perk_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'return', class: 'icon--sm' %}{{ block.settings.perk_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'lock', class: 'icon--sm' %}{{ block.settings.perk_3 | escape }}</li>{%- endif -%}
            </ul>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Trending now" },
        {
          "type": "select", "id": "style", "label": "Style",
          "options": [{ "value": "eyebrow", "label": "Eyebrow" }, { "value": "body", "label": "Body" }],
          "default": "eyebrow"
        }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true, "info": "Shop Pay, Apple Pay, PayPal etc. based on your payment settings." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Orders ship within 24 hours. Free returns within 30 days of delivery.</p>" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    },
    {
      "type": "trust",
      "name": "Perks",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Shipping perk", "default": "Free shipping over $50" },
        { "type": "text", "id": "perk_2", "label": "Returns perk", "default": "30-day returns" },
        { "type": "text", "id": "perk_3", "label": "Checkout perk", "default": "Secure checkout" }
      ]
    }
  ]
}
{% endschema %}
