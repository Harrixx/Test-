<section class="password">
  <div class="password__card">
    <p class="eyebrow">{% render 'icon', name: 'bolt', class: 'icon--xs' %}{{ 'templates.password.opening_soon' | t }}</p>
    <h1 class="page-title">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}

    <details class="password__login">
      <summary class="link">{{ 'templates.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="StorePassword">{{ 'templates.password.password' | t }}</label>
          <input class="input" type="password" name="password" id="StorePassword" placeholder="{{ 'templates.password.password' | t }}" autocomplete="current-password">
          <button type="submit" class="button">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password"
}
{% endschema %}
