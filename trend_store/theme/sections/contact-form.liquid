<section class="section page-width page-width--narrow">
  {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- form 'contact', id: 'ContactForm', class: 'stack-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">{{ 'templates.contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label>
      <span>{{ 'templates.contact.name' | t }}</span>
      <input class="input" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
    </label>
    <label>
      <span>{{ 'templates.contact.email' | t }} *</span>
      <input class="input" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
    </label>
    <label>
      <span>{{ 'templates.contact.order_number' | t }}</span>
      <input class="input" type="text" name="contact[order_number]">
    </label>
    <label>
      <span>{{ 'templates.contact.message' | t }}</span>
      <textarea class="input" rows="6" name="contact[body]">{{ form.body }}</textarea>
    </label>
    <button type="submit" class="button">{{ 'templates.contact.send' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
