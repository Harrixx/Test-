<article class="section page-width page-width--narrow">
  <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1 class="page-title">{{ article.title | escape }}</h1>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600', sizes: '(min-width: 990px) 760px, 100vw' }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="link-arrow" href="{{ blog.url }}">{{ 'templates.blog.back' | t }}</a></p>
</article>

{% schema %}
{
  "name": "Blog post",
  "class": "section-main-article"
}
{% endschema %}
