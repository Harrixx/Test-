<section class="section page-width">
  <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
  {%- paginate collections by 24 -%}
    <ul class="grid grid--3-col">
      {%- for collection in collections -%}
        <li>
          <a class="collection-card" href="{{ collection.url }}">
            <span class="collection-card__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 33vw, 100vw' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="collection-card__title">{{ collection.title | escape }} <small>{{ 'products.facets.product_count' | t: count: collection.products_count }}</small></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collections list page",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ]
}
{% endschema %}
