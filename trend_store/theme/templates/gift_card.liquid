{% layout none %}
{%- assign balance = gift_card.balance | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: balance, shop: shop.name | strip_html }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section page-width page-width--narrow gift-card">
      <h1 class="page-title">{{ shop.name }}</h1>
      <div class="gift-card__card">
        <p class="eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
        <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-message form-message--error">{{ 'gift_cards.issued.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %-d, %Y' -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}
        <p class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>
        {%- endif -%}
      </div>
      <p>
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </p>
    </main>
  </body>
</html>
