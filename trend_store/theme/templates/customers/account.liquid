<section class="section page-width">
  <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>
  <p>{{ 'customer.account.welcome' | t: name: customer.first_name }} &middot; <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a></p>

  <div class="account-grid">
    <div>
      <h2 class="section__heading">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="table">
            <thead><tr><th>{{ 'customer.order.order' | t }}</th><th>{{ 'customer.order.date' | t }}</th><th>{{ 'customer.order.payment_status' | t }}</th><th>{{ 'customer.order.fulfillment_status' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money_with_currency }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <aside>
      <h2 class="section__heading">{{ 'customer.account.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <p><a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a></p>
    </aside>
  </div>
</section>
