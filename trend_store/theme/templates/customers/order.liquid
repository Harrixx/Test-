<section class="section page-width">
  <p><a class="link" href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a></p>
  <h1 class="page-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign placed_on = order.created_at | date: '%B %-d, %Y' -%}
  <p>{{ 'customer.order.placed_on' | t: date: placed_on }}</p>
  {%- if order.cancelled -%}
    {%- assign cancelled_on = order.cancelled_at | date: '%B %-d, %Y' -%}
    <p class="form-message form-message--error">{{ 'customer.order.cancelled' | t: date: cancelled_on }}</p>
  {%- endif -%}

  <table class="table">
    <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            {{ line_item.title | link_to: line_item.product.url }}
            {%- if line_item.fulfillment -%}
              <br><small>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}
              {%- if line_item.fulfillment.tracking_url %} &middot; <a class="link" href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track' | t }}</a>{% endif -%}</small>
            {%- endif -%}
          </td>
          <td>{{ line_item.final_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="3">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr><td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr><td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>
      {%- endfor -%}
      <tr><td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
    </tfoot>
  </table>

  <div class="account-grid">
    <div>
      <h2 class="section__heading">{{ 'customer.order.billing_address' | t }}</h2>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h2 class="section__heading">{{ 'customer.order.shipping_address' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</section>
