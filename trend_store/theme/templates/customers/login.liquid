<section class="section page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.login.title' | t }}</h1>

  <div id="LoginWrapper">
    {%- form 'customer_login', class: 'stack-form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label><span>{{ 'customer.fields.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
      {%- if form.password_needed -%}
        <label><span>{{ 'customer.fields.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="current-password" required></label>
        <a href="#recover" class="link">{{ 'customer.login.forgot_password' | t }}</a>
      {%- endif -%}
      <button type="submit" class="button button--full">{{ 'customer.login.sign_in' | t }}</button>
      <a href="{{ routes.account_register_url }}" class="link">{{ 'customer.login.create_account' | t }}</a>
    {%- endform -%}
  </div>

  <div id="recover" class="recover">
    <h2 class="section__heading">{{ 'customer.recover.title' | t }}</h2>
    {%- form 'recover_customer_password', class: 'stack-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'customer.recover.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label><span>{{ 'customer.fields.email' | t }}</span><input class="input" type="email" name="email" autocomplete="email" required></label>
      <button type="submit" class="button button--secondary">{{ 'customer.recover.submit' | t }}</button>
    {%- endform -%}
  </div>

  {%- if shop.checkout.guest_login -%}
    <h2 class="section__heading">{{ 'customer.login.guest_title' | t }}</h2>
    {%- form 'guest_login' -%}
      <button type="submit" class="button button--secondary">{{ 'customer.login.guest_continue' | t }}</button>
    {%- endform -%}
  {%- endif -%}
</section>
