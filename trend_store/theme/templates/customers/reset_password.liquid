<section class="section page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'stack-form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label><span>{{ 'customer.fields.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label><span>{{ 'customer.fields.password_confirm' | t }}</span><input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</section>
