<section class="section page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'stack-form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label><span>{{ 'customer.fields.first_name' | t }}</span><input class="input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></label>
    <label><span>{{ 'customer.fields.last_name' | t }}</span><input class="input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></label>
    <label><span>{{ 'customer.fields.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" value="{{ form.email }}" required></label>
    <label><span>{{ 'customer.fields.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]" value="true"> {{ 'customer.register.marketing' | t }}</label>
    <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</section>
